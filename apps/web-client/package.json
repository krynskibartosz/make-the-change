{
  "name": "@make-the-change/web-client",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Application cliente Make the Change - Landing pages et app utilisateur",
  "scripts": {
    "dev": "next dev --turbo -p 3001",
    "build": "next build --turbo",
    "build:vercel": "next build --turbo",
    "start": "next start -p 3001",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "type-check": "tsc --noEmit",
    "type-check:exact-optional:pilot:marketing": "pnpm --filter @make-the-change/core build && tsc -p tsconfig.exact-optional.pilot.marketing.json --noEmit",
    "type-check:exact-optional:pilot": "pnpm --filter @make-the-change/web-client type-check:exact-optional:pilot:marketing",
    "assets:dioramas:remove-bg": "node ./scripts/remove-diorama-black-bg.mjs",
    "ts:metrics": "node ./scripts/ts-metrics.mjs",
    "ts:metrics:check": "node ./scripts/ts-metrics.mjs --check"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@make-the-change/core": "workspace:*",
    "@stripe/react-stripe-js": "^5.6.0",
    "@stripe/stripe-js": "^8.7.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.57.4",
    "@vis.gl/react-maplibre": "^8.1.1",
    "canvas-confetti": "^1.9.4",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.542.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.3",
    "next-intl": "^4.8.2",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "stripe": "^20.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  }
}
